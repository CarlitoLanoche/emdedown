# Normalise line endings of text files in the repository (the sources use LF).
* text=auto eol=lf

# Binary files: never convert or diff as text.
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.bmp binary
*.avif binary
*.pdf binary
*.docx binary
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary
*.nupkg binary
*.dll binary
*.exe binary
*.gz binary
